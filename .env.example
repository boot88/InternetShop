APP_NAME=TechZone
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

STORE_NAME=TechZone
STORE_PHONE=
STORE_EMAIL=
STORE_ADDRESS=
STORE_HOURS="Пн–Вс, 10:00–20:00"
STORE_TELEGRAM_URL=
STORE_LEGAL_NAME=
STORE_INN=
STORE_OGRN=
STORE_LEGAL_ADDRESS=
STORE_RETURN_ADDRESS=
STORE_BANK_DETAILS=
